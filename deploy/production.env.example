# Copy to deploy/production.env and protect it with mode 0600.
# Set this to the exact public origin with no trailing slash.
REACH_DOMAIN=reach.example.org
REACH_APP_ORIGIN=https://reach.example.org
REACH_ENVIRONMENT=production
REACH_RELEASE_PROFILE=extended

# Core community/account features stay disabled until their launch gates pass.
REACH_COMMUNITY_ENABLED=false
REACH_ACCOUNT_ENABLED=false
REACH_COMMUNITY_DB=/var/lib/reach/community.sqlite

# Operator attestations: set an individual gate true only after its launch
# checks pass. The core release ignores optional features regardless.
REACH_RELEASE_ACCOUNTS=false
REACH_RELEASE_GOOGLE=false
REACH_RELEASE_EMAIL=false
REACH_RELEASE_COMMUNITY=false
REACH_RELEASE_VOLUNTEERING=false
REACH_RELEASE_AI=true

# Llama runs privately with the app; external email/routing remain explicitly off.
REACH_EMAIL_PROVIDER=disabled
REACH_AI_PROVIDER=ollama
REACH_AI_DATA_POLICY_ACCEPTED=true
OSM_ROUTER_MODE=disabled
# Leave empty until a compliant geocoder host is selected and its requirements
# (including rate limits, attribution, privacy and contact details) are met.
OSM_GEOCODER_URL=
# Public Nominatim requires an explicit single-instance opt-in.
OSM_NOMINATIM_SINGLE_INSTANCE=false
# When enabling routing or geocoding, supply Reach plus a real project URL or
# contact email; remove sample domains and contact details.
OSM_USER_AGENT=
OSM_ROUTER_URL=
# The public Valhalla demo is preview-only; never enable it for production.
REACH_ROUTER_DEMO_ACKNOWLEDGED=false

# The NEXT_PUBLIC_MAP_* values are public and are passed to the Docker build.
# Empty values use the app's built-in map style; review its provider terms and
# operational suitability before publishing. These are not credentials.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_RASTER_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_RASTER_ATTRIBUTION=

# Optional Google sign-in. Keep accounts disabled until credentials and the
# exact HTTPS callback URI have been privately configured and verified.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email provider settings. Configure privately only after selecting a
# reviewed provider and verifying the sending identity and application origin.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Optional DeepSeek settings. AI remains release-gated and disabled until a key
# is configured and the operator reviews and accepts the applicable data policy.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=12000
REACH_AI_USAGE_LOGGING=false

OLLAMA_MODEL=llama3.2:3b

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

OLLAMA_TIMEOUT_MS=40000
