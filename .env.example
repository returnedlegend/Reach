# The example enables primary Llama AI; other production features retain their gates.
# The core profile can run local AI when REACH_RELEASE_AI=true; use REACH_AI_PROVIDER=disabled to turn it off.
# To enable an optional production feature, use extended and set ONLY the reviewed
# feature's REACH_RELEASE_* switch true after its end-to-end release checks.
REACH_RELEASE_ACCOUNTS=false
REACH_RELEASE_GOOGLE=false
REACH_RELEASE_EMAIL=false
REACH_RELEASE_COMMUNITY=false
REACH_RELEASE_VOLUNTEERING=false
REACH_RELEASE_AI=true

# The default MapLibre map uses OpenFreeMap and needs no key.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional raster source. For OSM Foundation tiles, follow its usage policy.
# NEXT_PUBLIC_MAP_RASTER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_RASTER_ATTRIBUTION=

# Address search is disabled until deliberately enabled.
# Public Nominatim needs an informed single-instance opt-in and identifying contact.
# OSM_GEOCODER_URL=https://nominatim.openstreetmap.org
# OSM_NOMINATIM_SINGLE_INSTANCE=true
# OSM_USER_AGENT=Reach (https://example.org; contact: maps@example.org)

# Routing defaults to disabled. Transit uses the published BTD timetable separately.
OSM_ROUTER_MODE=disabled
# To use a permitted, self-hosted Valhalla-compatible route service:
# OSM_ROUTER_MODE=valhalla
# OSM_ROUTER_URL=https://your-valhalla-service.example
# For a low-volume, single-instance prototype only, deliberately copy these
# settings into .env.local after reading docs/OPENSTREETMAP.md and the FOSSGIS
# terms. The server applies a 1.1-second shared-host request interval; FOSSGIS
# allows at most one request per second. OSM_ROUTER_MODE=valhalla-demo uses
# https://valhalla1.openstreetmap.de and has no production SLA.
# OSM_ROUTER_MODE=valhalla-demo
# OSM_USER_AGENT=Reach (https://example.org; contact: maps@example.org)
# Keep OSM attribution and the FOSSGIS-required fix-the-map link visible.
# The 100-mile journey cap is a Reach safeguard, not a FOSSGIS quota.


# Community pilot: disabled by default in development and production.
# npm run dev:community explicitly opts in for that local process.
# Requires Node24 and a persistent single-host filesystem, not serverless storage.
REACH_COMMUNITY_ENABLED=false
# REACH_COMMUNITY_DB=/absolute/private/path/community.sqlite
# Bootstrap a moderator via scripts/community-admin.ts; never commit passwords.
# Behind a reviewed HTTPS reverse proxy, set the exact public origin (no slash).
# REACH_COMMUNITY_ORIGIN=https://your-canonical-host.example

# Email accounts + pantry management use the same persistent SQLite database.
# Mail defaults to disabled. Choose preview for local development or Resend for
# production. See docs/RESEND.md.
# Keep these server-only. Never use NEXT_PUBLIC_ names for credentials.
# REACH_APP_ORIGIN=https://your-canonical-host.example
# Local development preview: captures private files; sends no external mail.
# REACH_EMAIL_PROVIDER=preview
# REACH_APP_ORIGIN=http://localhost:3000
# REACH_EMAIL_PREVIEW_DIR=.local/mail-preview
# Standalone worker: explicitly use NODE_ENV=development and load .env.local:
# NODE_ENV=development node --env-file=.env.local --import tsx scripts/mail-worker.ts --once
# Use --watch for polling. The app and worker must use the same database/origin.
# Never use preview in production or put captures under a served directory.

# Production Resend delivery; keep credentials in secure environment settings.
# REACH_EMAIL_PROVIDER=resend
# REACH_APP_ORIGIN=https://your-canonical-host.example
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="Reach <notifications@yourdomain.com>"
# Replace these placeholders with a real key and verified sender before enabling Resend.
# Optional, when configuring https://your-canonical-host.example/api/email/webhook:
# RESEND_WEBHOOK_SECRET=
# REACH_EMAIL_HOURLY_LIMIT=100
# REACH_EMAIL_USER_HOURLY_LIMIT=20

# REACH_ACCOUNT_ENABLED=false
# Optional emergency switch above disables account endpoints (default: enabled).
# Bootstrap pantry administrator AFTER verifying an email account:
# npm run account:admin -- administrator@example.org
# Community moderator and pantry administrator are separate permissions.

# Primary Llama AI and retained explicit DeepSeek settings (server-only).
# Direct DeepSeek API usage is billed by DeepSeek; see docs/DEEPSEEK.md.
# Deterministic pantry search and trip planning work with AI disabled.
REACH_AI_PROVIDER=ollama
REACH_AI_DATA_POLICY_ACCEPTED=true
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# Optional total deadline, including retries: 1000–20000ms; default12000.
# DEEPSEEK_TIMEOUT_MS=12000
# Optional process-local aggregate request/token logs, never prompts or responses.
# REACH_AI_USAGE_LOGGING=false
# Optional unrelated explicit Groq/Gemini providers retain their separate cost opt-ins.
# REACH_AI_MODEL=
# REACH_AI_FREE_ONLY=true
# REACH_AI_ALLOW_PAID=false
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_INBOUND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
REACH_OUTREACH_REPLY_DOMAIN=
# Route attempts for up to 8 eligible sites; known timing failures do not consume
# this site limit. Set 1–24. The independent 12-call/25-second route budget remains.
REACH_ACCESS_CANDIDATES=8
# Limits per feature (PREFERENCES, NEEDS, GUIDANCE, DRAFT, REPLY); defaults 32/day, 5/minute.
# 0 disables a feature; malformed values fail closed. Global caps:128/day,20/min.
# REACH_AI_PREFERENCES_DAILY_LIMIT=32
# REACH_AI_DRAFT_DAILY_LIMIT=32
# REACH_AI_REPLY_DAILY_LIMIT=32
# REACH_AI_PREFERENCES_MINUTE_LIMIT=5
# REACH_AI_DRAFT_MINUTE_LIMIT=5
# REACH_AI_REPLY_MINUTE_LIMIT=5
# Optional JSON ranking weights (nonnegative values up to100):
# REACH_ACCESS_WEIGHTS={"travelMinute":1,"walkingMinute":2,"dollar":4,"transfer":8,"uncertainty":12,"closingSlackMinute":0.1,"waitingMinute":0,"timeToServiceMinute":0}
# Inbound: configure a receiving subdomain/MX in Resend; use its endpoint secret.
# RESEND_INBOUND_API_KEY may reuse RESEND_API_KEY if it has receiving-read access.
# Never put inbound credentials or private replies in browser variables.

# Resend SMTP + optional AI assistant (server-only)
# Sending requires REACH_EMAIL_PROVIDER=smtp and a verified sender; preview stays explicit.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Reach
GEMINI_MODEL=

# Google account sign-in (server-only OAuth Web application credentials).
# These are distinct from Google Maps keys. No Gmail permission is requested.
# Exact callback: REACH_APP_ORIGIN + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primary Llama 3.2 provider via the website server’s private Ollama service.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=40000

REACH_RELEASE_PROFILE=extended
